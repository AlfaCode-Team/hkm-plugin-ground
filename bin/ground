#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ground — the plugin developer's command.
 *
 *     cd ~/…/PLUGINS/PHP/hkm-plugin-user
 *     ground              # where am I, and what can I do
 *     ground install      # dependencies, from the checkouts next door
 *     ground check        # is this plugin well-formed
 *     ground serve        # browse it
 *     ground test         # run its tests
 *
 * Six verbs, no arguments needed. The plugin is the one you are standing in;
 * naming one is for reaching a DIFFERENT plugin (`ground check view`).
 *
 * ─── WHY A WRAPPER ──────────────────────────────────────────────────────────
 *
 * Underneath, these are ordinary kernel CLI commands — `plugin:check`,
 * `plugin:probe`, `plugin:serve`, `make:ground-test` — the same ones a project
 * gets through `hkm`. That naming is right INSIDE a project, where they sit
 * beside fifty other commands and the prefix is what tells you whose they are.
 *
 * It is wrong here. While developing a plugin there is nothing to disambiguate
 * from, and `../hkm-plugin-ground/bin/ground plugin:check user` is nine words to
 * say "check this". So the verbs live here and the commands stay as they are;
 * anything this does not recognise is passed straight through, so the long
 * forms and every flag keep working.
 */

$autoload = __DIR__ . '/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "ground: dependencies are not installed.\nRun `composer install` in " . \dirname(__DIR__) . ".\n");

    exit(1);
}

require $autoload;

use Plugins\Ground\Ground\PluginGround;
use Plugins\Ground\Inspection\PluginLocator;
use Plugins\Ground\Ui\UiManifest;

$argv = $_SERVER['argv'];
$verb = $argv[1] ?? '';
$rest = \array_slice($argv, 2);

/** Run one of the kernel CLI commands, in a throwaway workspace. */
$kernel = static function (array $args): int {
    $ground = PluginGround::for(\Plugins\Ground\Provider::class)->boot();

    try {
        // argv[0] is the script name; CliPipeline::run() slices it off itself.
        return $ground->kernel()->cli()->run(['ground', ...$args]);
    } finally {
        $ground->destroy();
    }
};

/** The plugin the working directory is in, or null. */
$current = static fn(): ?object => PluginLocator::fromCwd()->current();

/** Run a shell command in the plugin, streaming its output. */
$shell = static function (string $command, string $cwd): int {
    passthru('cd ' . escapeshellarg($cwd) . ' && ' . $command, $code);

    return $code;
};

switch ($verb) {
    // ── install ───────────────────────────────────────────────────────────────
    case 'install':
    case 'i':
        $plugin = $current();

        if ($plugin === null) {
            fwrite(STDERR, "ground: this directory is not a plugin.\n");

            exit(1);
        }

        $dir = $plugin->directory();

        // PHP first: the UI step needs the locator, which needs the harness.
        $code = $shell(escapeshellarg(__DIR__ . '/link-local'), $dir);

        if ($code !== 0) {
            exit($code);
        }

        // Then the UI, but only for a plugin that ships one. Doing it silently
        // for every plugin would pull ~250 npm packages into repositories that
        // have no frontend at all.
        if (UiManifest::for($dir)->exists && !\in_array('--no-ui', $rest, true)) {
            fwrite(STDOUT, "\nground: installing the UI test setup…\n");
            $kernel(['make:ui-test', $plugin->name(), '--config']);
            $shell('npm install --no-audit --no-fund', $dir . '/ui');
        }

        fwrite(STDOUT, "\nground: ready. Try `ground check`, `ground test` or `ground serve`.\n");

        exit(0);

    // ── the kernel commands, under short names ────────────────────────────────
    case 'check':
        exit($kernel(['plugin:check', ...$rest]));

    case 'probe':
        exit($kernel(['plugin:probe', ...$rest]));

    case 'serve':
        exit($kernel(['plugin:serve', ...$rest]));

    case 'new':
        // `ground new test` / `ground new ui-test` — the scaffolders, named for
        // what they make rather than for the command that makes it.
        $what = array_shift($rest) ?? 'test';

        exit(match ($what) {
            'test', 'ground-test' => $kernel(['make:ground-test', ...$rest]),
            'ui', 'ui-test'       => $kernel(['make:ui-test', ...$rest, '--config']),
            default               => (static function () use ($what): int {
                fwrite(STDERR, "ground: `new {$what}`? Try `ground new test` or `ground new ui-test`.\n");

                return 1;
            })(),
        });

    // ── test ──────────────────────────────────────────────────────────────────
    case 'test':
    case 't':
        $plugin = $current();

        if ($plugin === null) {
            fwrite(STDERR, "ground: this directory is not a plugin.\n");

            exit(1);
        }

        $dir    = $plugin->directory();
        $failed = 0;

        if (is_file($dir . '/vendor/bin/phpunit')) {
            $failed |= $shell('vendor/bin/phpunit ' . implode(' ', array_map('escapeshellarg', $rest)), $dir);
        } else {
            fwrite(STDOUT, "ground: no vendor/bin/phpunit — run `ground install` first.\n");
            $failed = 1;
        }

        // The UI half runs only when it CAN. A plugin with pages but no npm
        // install yet should be told, not silently reported as fully passing.
        if (is_dir($dir . '/ui/__tests__')) {
            if (is_dir($dir . '/ui/node_modules')) {
                fwrite(STDOUT, "\n");
                $failed |= $shell('npx vitest run', $dir . '/ui');
            } else {
                fwrite(STDOUT, "\nground: ui/__tests__ exists but node_modules does not — run `ground install`.\n");
            }
        }

        exit($failed === 0 ? 0 : 1);

    // ── status ────────────────────────────────────────────────────────────────
    case '':
    case 'help':
    case '--help':
    case '-h':
        $plugin = $current();
        $line   = static fn(string $s = '') => fwrite(STDOUT, $s . "\n");

        $line();

        if ($plugin === null) {
            $found = array_keys(PluginLocator::fromCwd()->all());

            $line('  ground — no plugin here.');
            $line();
            $line('  cd into a plugin, or name one.');
            $line($found === [] ? '  (none found nearby)' : '  Nearby: ' . implode(', ', $found));
        } else {
            $dir = $plugin->directory();
            $ui  = UiManifest::for($dir);

            $line('  ' . $plugin->name() . '  —  ' . ($plugin->solves() ?: 'no domain'));
            $line();
            $line('  installed   ' . (is_dir($dir . '/vendor') ? 'yes' : 'no — run `ground install`'));
            $line('  routes      ' . \count($plugin->allRoutes()));
            $line('  requires    ' . ($plugin->requires() === [] ? '—' : implode(', ', $plugin->requires())));
            $line('  ui          ' . ($ui->exists
                ? \count($ui->pageFiles()) . ' page(s)' . (is_dir($dir . '/ui/node_modules') ? '' : ' — not installed')
                : 'none'));
        }

        $line();
        $line('  install     dependencies, from the checkouts next door');
        $line('  check       static checks — the mistakes a boot cannot catch');
        $line('  probe       boot it and report what compiled');
        $line('  serve       browse it at http://127.0.0.1:8321');
        $line('  test        phpunit, and vitest if there are page tests');
        $line('  new test    scaffold tests from module.json  (new ui-test for pages)');
        $line();
        $line('  Add a plugin name to any of them to reach a different one.');
        $line('  Anything else is passed through to the kernel CLI (`ground list`).');
        $line();

        exit(0);

    // ── passthrough ───────────────────────────────────────────────────────────
    default:
        // The long forms and everything else the kernel CLI knows: `ground
        // plugin:check --json`, `ground list`, `ground help plugin:serve`.
        exit($kernel(\array_slice($argv, 1)));
}
